# Nginx reverse proxy configuration
# Copy this file to .env and configure

# Server identification (at least one required)
# DOMAIN takes precedence over IP if both are set
# Get your current IP: curl -sSL ip.kyxap.pro | jq .ip -r
DOMAIN=
IP=

# Let's Encrypt configuration
# Set to true to enable automatic certificate management
USE_LETSENCRYPT=false

# Let's Encrypt environment: staging | production
# Use staging for testing to avoid rate limits (certs will be untrusted)
# Switch to production only when everything works
LETSENCRYPT_ENV=staging

# Contact email for Let's Encrypt notifications
ACME_EMAIL=admin@example.com

# Authentication method: cognito | basic
# - cognito: OAuth2/OIDC via AWS Cognito (requires oauth2-proxy)
# - basic: htpasswd file authentication
AUTH_METHOD=basic

# AWS Cognito Configuration (required when AUTH_METHOD=cognito)
# Get these values from AWS Console → Cognito → Your User Pool
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret

# Cookie encryption secret (generate with: openssl rand -base64 32 | head -c 32 | xargs)
OAUTH2_COOKIE_SECRET=

# Allowed email domains for OAuth2 login (comma-separated, * = any)
# Examples: * | company.com | company.com,partner.org
OAUTH2_EMAIL_DOMAINS=*

# Docker Compose Configuration (Optional override)
# Default (Real UI):
# COMPOSE_FILE=docker-compose.yaml:docker-compose.override.yml
#
# With Mock Backend (overrides real UI):
# COMPOSE_FILE=docker-compose.yaml:docker-compose.override.yml:docker-compose.mock.yml
COMPOSE_FILE=docker-compose.yaml:docker-compose.override.yml

# Docker Compose Profiles (Optional)
# Controls which additional services are started.
# - (empty or commented out) -> Normal run
# - cognito -> Also starts oauth2-proxy
# Examples: cognito
COMPOSE_PROFILES=
